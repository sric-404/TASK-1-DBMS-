-- Task VII: SQL Query Implementation for E-Commerce Database
-- Uses the existing tables created in previous tasks:
-- Customer, Category, Product, Orders and Order_Details

-- ============================================================
-- 1. SELECT, WHERE, ORDER BY AND DISTINCT QUERIES
-- ============================================================

-- Display all products
SELECT * FROM Product;

-- Display products priced above 1000
SELECT *
FROM Product
WHERE price > 1000;

-- Display products from highest price to lowest price
SELECT *
FROM Product
ORDER BY price DESC;

-- Display distinct category IDs used by products
SELECT DISTINCT category_id
FROM Product;


-- ============================================================
-- 2. SEARCH PRODUCTS BASED ON PRICE, CATEGORY AND AVAILABILITY
-- ============================================================

-- Products within a price range
SELECT product_id, product_name, price, stock, brand
FROM Product
WHERE price BETWEEN 500 AND 5000;

-- Products belonging to category 1
SELECT product_id, product_name, category_id, price, stock, brand
FROM Product
WHERE category_id = 1;

-- Products currently available in stock
SELECT product_id, product_name, price, stock
FROM Product
WHERE stock > 0;

-- Search using price, category and availability together
SELECT product_id, product_name, category_id, price, stock, brand
FROM Product
WHERE price < 5000
  AND category_id = 1
  AND stock > 0;

-- Search by category name
SELECT
    p.product_id,
    p.product_name,
    c.category_name,
    p.price,
    p.stock,
    p.brand
FROM Product p
JOIN Category c
    ON p.category_id = c.category_id
WHERE c.category_name = 'Electronics';


-- ============================================================
-- 3. RETRIEVE CUSTOMER AND PRODUCT INFORMATION
-- ============================================================

-- Retrieve customer information
SELECT
    customer_id,
    name,
    email,
    phone,
    address
FROM Customer;

-- Retrieve product information with category details
SELECT
    p.product_id,
    p.product_name,
    c.category_name,
    p.price,
    p.stock,
    p.brand
FROM Product p
JOIN Category c
    ON p.category_id = c.category_id;

-- Retrieve customers and the products they ordered
SELECT
    c.customer_id,
    c.name AS customer_name,
    o.order_id,
    o.order_date,
    p.product_id,
    p.product_name,
    od.quantity,
    od.unit_price,
    o.total_amount,
    o.order_status
FROM Customer c
JOIN Orders o
    ON c.customer_id = o.customer_id
JOIN Order_Details od
    ON o.order_id = od.order_id
JOIN Product p
    ON od.product_id = p.product_id
ORDER BY c.customer_id, o.order_date;


-- ============================================================
-- 4. APPLY FILTERING CONDITIONS
-- ============================================================

-- Products priced above 1000 with at least 10 items in stock
SELECT *
FROM Product
WHERE price > 1000
  AND stock >= 10;

-- Products from selected categories using IN
SELECT
    p.product_name,
    c.category_name,
    p.price
FROM Product p
JOIN Category c
    ON p.category_id = c.category_id
WHERE c.category_name IN ('Electronics', 'Mobiles');

-- Search products by name
SELECT *
FROM Product
WHERE product_name LIKE '%Phone%';

-- Orders with amount greater than 5000 and confirmed/shipped status
SELECT
    order_id,
    customer_id,
    order_date,
    total_amount,
    order_status
FROM Orders
WHERE total_amount > 5000
  AND order_status IN ('Confirmed', 'Shipped')
ORDER BY total_amount DESC;

-- Customers from selected cities
SELECT *
FROM Customer
WHERE address IN ('Chennai', 'Bengaluru', 'Hyderabad');


-- ============================================================
-- 5. BASIC BUSINESS REPORTS
-- ============================================================

-- Report 1: Number of products in each category
SELECT
    c.category_id,
    c.category_name,
    COUNT(p.product_id) AS total_products
FROM Category c
LEFT JOIN Product p
    ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name
ORDER BY c.category_name;

-- Report 2: Average product price by category
SELECT
    c.category_name,
    ROUND(AVG(p.price), 2) AS average_price
FROM Category c
JOIN Product p
    ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name
ORDER BY average_price DESC;

-- Report 3: Total available stock by category
SELECT
    c.category_name,
    SUM(p.stock) AS total_stock
FROM Category c
JOIN Product p
    ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name
ORDER BY total_stock DESC;

-- Report 4: Top 5 most expensive products
SELECT
    product_id,
    product_name,
    brand,
    price
FROM Product
ORDER BY price DESC
LIMIT 5;

-- Report 5: Low-stock products
SELECT
    product_id,
    product_name,
    stock
FROM Product
WHERE stock < 20
ORDER BY stock ASC;

-- Report 6: Customer order summary
SELECT
    c.customer_id,
    c.name AS customer_name,
    COUNT(o.order_id) AS total_orders,
    COALESCE(SUM(o.total_amount), 0) AS total_spent
FROM Customer c
LEFT JOIN Orders o
    ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.name
ORDER BY total_spent DESC;

-- Report 7: Product sales summary
SELECT
    p.product_id,
    p.product_name,
    COALESCE(SUM(od.quantity), 0) AS total_quantity_sold,
    COALESCE(SUM(od.quantity * od.unit_price), 0) AS sales_value
FROM Product p
LEFT JOIN Order_Details od
    ON p.product_id = od.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_quantity_sold DESC, sales_value DESC;
